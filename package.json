{
  "name": "app-agency-tycoon",
  "version": "2.0.0",
  "private": true,
  "description": "Jogo tycoon de agência de desenvolvimento de apps (pt-BR)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.include=src/core/**/*.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write src test docs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "empresa": "concurrently -k -n ponte,vite \"npm --prefix server run dev\" \"npm run dev\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
