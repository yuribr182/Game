# Copie para .env (gitignored) e preencha.
# Chave da API da Anthropic — NUNCA commitar a real.
ANTHROPIC_API_KEY=

# PAT do GitHub (fine-grained, Contents: Read and write; para abrir PR, marque também Pull requests: Read and write) — usado só em projetos tipo "codigo".
GITHUB_TOKEN=

# Notificações no celular via Telegram (opcional — F4).
# 1) Crie um bot com o @BotFather e cole o token abaixo.
# 2) Mande um "oi" para o seu bot e pegue o chat_id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Porta da ponte local.
PORTA=3777
