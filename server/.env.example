# ============================================================
# Agência Real — configuração da ponte local (server/.env)
# Copie este arquivo para server/.env e preencha o que for usar.
# Campos vazios só desligam a integração — nada quebra sem eles.
# ============================================================

# ---- Anthropic (OBRIGATÓRIA: é o cérebro dos funcionários) ----
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ---- GitHub (só para projetos de CÓDIGO: clone, push e PR) ----
# Fine-grained PAT com Contents: Read/Write + Pull requests: Read/Write
GITHUB_TOKEN=

# ---- Telegram (opcional: notificações no celular) ----
# Crie o bot com o @BotFather; mande "oi" pro bot e pegue o chat id em /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Mercado Livre (rotinas: responder perguntas e atualizar anúncios) ----
# developers.mercadolivre.com.br → crie um app → client id/secret;
# faça o fluxo OAuth 1x para obter o refresh token da SUA conta de vendedor.
# (o refresh token rotaciona — a ponte guarda o novo automaticamente)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# ---- Instagram / Meta (rotina: publicar posts na conta profissional) ----
# developers.facebook.com → app com Instagram Graph API;
# token de longa duração da Página + id da conta IG business
META_ACCESS_TOKEN=
META_IG_USER_ID=

# ---- Google Ads (campanhas) ----
# A exportação em CSV p/ Google Ads Editor funciona SEM chave nenhuma.
# Para a API oficial (futuro): developer token aprovado + OAuth
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ---- Ponte ----
PORTA=3777
